<!DOCTYPE html>
<html lang="{{lang|ru}}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{your_company}} × {{client_name}}</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family={{font_body_url|Inter}}:wght@400;500;600;700&family={{font_display_url|DM+Serif+Display}}:ital@0;1&display=swap" rel="stylesheet">

<style>
:root {
  --primary-dark: {{primary_dark}};
  --primary-dark-light: {{primary_dark_lighter}};
  --accent: {{accent}};
  --accent-hover: {{accent_darker}};
  --background-light: {{background_light}};
  --white: #FFFFFF;

  --text-on-light: {{primary_dark}};
  --text-on-light-secondary: #4A5568;
  --text-on-light-muted: #64748B;
  --text-on-dark: #FFFFFF;
  --text-on-dark-secondary: #94A3B8;
  --text-on-dark-muted: #CBD5E1;

  --border-on-dark: {{primary_dark_lighter}};
  --border-on-light: #E2E8F0;

  --radius: 16px;
  --radius-pill: 100px;

  --font-display: '{{font_display}}', Georgia, serif;
  --font-body: '{{font_body}}', -apple-system, BlinkMacSystemFont, sans-serif;
}

* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: var(--font-body); color: var(--text-on-light); line-height: 1.5; }

/* === Header === */
.header {
  background: var(--primary-dark);
  padding: 24px 48px;
  border-bottom: 1px solid var(--border-on-dark);
}
.header-logo {
  display: flex; align-items: center; gap: 18px;
  max-width: 1200px; margin: 0 auto;
}
.brand-block { display: flex; align-items: center; gap: 10px; }
.logo-svg { height: 36px; width: auto; filter: brightness(0) invert(1); }
.brand-name { font-family: var(--font-display); font-size: 22px; color: var(--text-on-dark); }
.separator { color: var(--accent); font-size: 18px; opacity: 0.6; }
.client-name { font-family: var(--font-display); font-size: 20px; color: var(--text-on-dark); }

/* === Sections === */
section { padding: 80px 48px; }
.section-inner { max-width: 1200px; margin: 0 auto; }
.section-dark { background: var(--primary-dark); color: var(--text-on-dark); }
.section-light { background: var(--background-light); color: var(--text-on-light); }
.section-white { background: var(--white); color: var(--text-on-light); }

.section-label {
  font-size: 12px; font-weight: 600;
  text-transform: uppercase; letter-spacing: 0.08em;
  color: var(--accent); margin-bottom: 16px;
}
.section-title {
  font-family: var(--font-display); font-size: 42px; font-style: italic;
  margin-bottom: 48px;
}
.section-dark .section-title { color: var(--background-light); }
.section-light .section-title, .section-white .section-title { color: var(--accent); }

/* === Hero === */
.hero h1 {
  font-family: var(--font-display); font-size: 64px;
  line-height: 1.05; margin-bottom: 24px;
}
.hero p.lead {
  font-size: 20px; max-width: 720px; color: var(--text-on-dark-secondary);
  margin-bottom: 40px;
}

/* === Metrics === */
.metrics { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; }
.metric-value {
  font-family: var(--font-display); font-size: 44px; color: var(--accent);
  margin-bottom: 8px;
}
.metric-label { font-size: 14px; color: var(--text-on-dark-secondary); }

/* === Client logos === */
.client-logos {
  display: grid; grid-template-columns: repeat(5, 1fr); gap: 32px;
  align-items: center; justify-items: center;
}
.client-logos img { max-width: 120px; height: auto; opacity: 0.85; filter: brightness(0) invert(1); }

/* === Services / Advantages cards === */
.cards-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; }
.card {
  background: var(--white);
  border: 1px solid var(--border-on-light);
  border-top: 3px solid var(--accent);
  border-radius: var(--radius);
  padding: 28px;
}
.card-dark {
  background: var(--primary-dark-light);
  border-left: 3px solid var(--accent);
  border-radius: var(--radius);
  padding: 32px;
}
.card h3, .card-dark h3 {
  font-family: var(--font-body); font-weight: 700; font-size: 22px;
  margin-bottom: 12px;
}
.card-dark h3 { color: var(--text-on-dark); }
.card p { color: var(--text-on-light-secondary); }
.card-dark p { color: var(--text-on-dark-muted); }

/* === Team === */
.team-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 32px; }
.team-member { text-align: center; }
.team-photo {
  width: 80px; height: 80px; border-radius: 50%; object-fit: cover;
  margin: 0 auto 16px;
}
.team-member h4 {
  font-family: var(--font-display); font-size: 20px; margin-bottom: 4px;
}
.team-member .role { color: var(--accent); font-size: 14px; font-weight: 600; margin-bottom: 12px; }
.team-member p { font-size: 14px; color: var(--text-on-light-secondary); }

/* === Portfolio === */
.portfolio-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; }
.portfolio-card {
  background: var(--white);
  border: 1px solid var(--border-on-light);
  border-radius: var(--radius);
  padding: 28px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
}
.portfolio-badge {
  display: inline-block; padding: 4px 14px;
  border: 1px solid var(--accent); color: var(--accent);
  border-radius: var(--radius-pill);
  font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em;
  margin-bottom: 16px;
}
.portfolio-card h3 {
  font-family: var(--font-body); font-weight: 700; font-size: 20px;
  margin-bottom: 12px; line-height: 1.3;
}
.portfolio-card p { color: var(--text-on-light-secondary); font-size: 15px; }

/* === Footer === */
.footer { background: var(--primary-dark); color: var(--text-on-dark); padding: 64px 48px 48px; }
.footer-inner { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; }
.footer h3 { font-family: var(--font-display); font-size: 24px; margin-bottom: 16px; }
.footer-contacts a { color: var(--text-on-dark); text-decoration: none; display: block; margin-bottom: 8px; }
.footer-contacts a:hover { color: var(--accent); }

/* === Responsive === */
@media (max-width: 768px) {
  section { padding: 48px 24px; }
  .header { padding: 16px 24px; }
  .hero h1 { font-size: 40px; }
  .section-title { font-size: 32px; }
  .metrics { grid-template-columns: repeat(2, 1fr); }
  .client-logos { grid-template-columns: repeat(3, 1fr); }
  .footer-inner { grid-template-columns: 1fr; }
}
</style>
</head>
<body>

<!-- ============================== HEADER ============================== -->
<header class="header">
  <div class="header-logo">
    <div class="brand-block">
      {{#logo_path}}<img src="{{logo_path}}" alt="{{your_company}}" class="logo-svg">{{/logo_path}}
      <span class="brand-name">{{your_company}}</span>
    </div>
    <span class="separator">×</span>
    <span class="client-name">{{client_name}}</span>
  </div>
</header>

<!-- ============================== HERO ============================== -->
<section class="section-dark hero">
  <div class="section-inner">
    <div class="section-label">// Предложение для {{client_name}}</div>
    <h1>{{hero_h1}}</h1>
    <p class="lead">{{hero_lead}}</p>
  </div>
</section>

<!-- ============================== METRICS ============================== -->
<section class="section-dark">
  <div class="section-inner">
    <div class="section-label">// {{your_company}} в цифрах</div>
    <div class="metrics">
      {{#metrics}}
      <div>
        <div class="metric-value">{{value}}</div>
        <div class="metric-label">{{label}}</div>
      </div>
      {{/metrics}}
    </div>
  </div>
</section>

<!-- ============================== CLIENT LOGOS (опц.) ============================== -->
{{#client_logos}}
<section class="section-dark">
  <div class="section-inner">
    <div class="section-label">// С кем работаем</div>
    <div class="client-logos">
      {{#each}}
      <img src="{{path}}" alt="{{name}}">
      {{/each}}
    </div>
  </div>
</section>
{{/client_logos}}

<!-- ============================== SERVICES ============================== -->
<section class="section-light">
  <div class="section-inner">
    <div class="section-label">// Что мы делаем</div>
    <h2 class="section-title">Направления.</h2>
    <div class="cards-grid">
      {{#services}}
      <div class="card">
        <h3>{{title}}</h3>
        <p>{{description}}</p>
      </div>
      {{/services}}
    </div>
  </div>
</section>

<!-- ============================== ADVANTAGES ============================== -->
<section class="section-dark">
  <div class="section-inner">
    <div class="section-label">// Почему {{your_company}}</div>
    <h2 class="section-title">Преимущества.</h2>
    <div class="cards-grid">
      {{#advantages}}
      <div class="card-dark">
        <h3>{{title}}</h3>
        <p>{{description}}</p>
      </div>
      {{/advantages}}
    </div>
  </div>
</section>

<!-- ============================== TEAM ============================== -->
<section class="section-light">
  <div class="section-inner">
    <div class="section-label">// Команда</div>
    <h2 class="section-title">Кто на проекте.</h2>
    <div class="team-grid">
      {{#team}}
      <div class="team-member">
        {{#photo_path}}<img src="{{photo_path}}" alt="{{name}}" class="team-photo">{{/photo_path}}
        <h4>{{name}}</h4>
        <div class="role">{{role}}</div>
        <p>{{bio}}</p>
      </div>
      {{/team}}
    </div>
  </div>
</section>

<!-- ============================== PORTFOLIO ============================== -->
<section class="section-white">
  <div class="section-inner">
    <div class="section-label">// Портфолио</div>
    <h2 class="section-title">Что уже делали.</h2>
    <div class="portfolio-grid">
      {{#portfolio}}
      <div class="portfolio-card">
        <span class="portfolio-badge">{{category}}</span>
        <h3>{{title}}</h3>
        <p>{{result}}</p>
      </div>
      {{/portfolio}}
    </div>
  </div>
</section>

<!-- ============================== Pricing section placeholder ============================== -->
<!-- Pricing section placeholder. Если в КП нужна смета — добавь сюда таблицу со стоимостью.
     skill make-proposal сознательно не генерирует pricing-блок — это твоя личная часть. -->

<!-- ============================== FOOTER ============================== -->
<footer class="footer">
  <div class="footer-inner">
    <div>
      <h3>{{your_company}}</h3>
      <p style="color: var(--text-on-dark-secondary); max-width: 480px;">{{your_company_short}}</p>
    </div>
    <div class="footer-contacts">
      <h3>Контакты</h3>
      {{#email}}<a href="mailto:{{email}}">{{email}}</a>{{/email}}
      {{#phone}}<a href="tel:{{phone_raw}}">{{phone}}</a>{{/phone}}
      {{#website}}<a href="https://{{website}}" target="_blank">{{website}}</a>{{/website}}
      {{#linkedin}}<a href="https://{{linkedin}}" target="_blank">LinkedIn</a>{{/linkedin}}
      {{#telegram}}<a href="https://t.me/{{telegram_handle}}" target="_blank">Telegram: {{telegram}}</a>{{/telegram}}
    </div>
  </div>
</footer>

</body>
</html>
